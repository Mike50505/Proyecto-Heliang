# Copiar a .env en Debian; no contiene secretos reales.
# Para un despliegue existente, conservar la SECRET_KEY y contraseña actuales.
DJANGO_DEBUG=0
DJANGO_SECRET_KEY=
POSTGRES_PASSWORD=

# Hosts sin http://, sin :8000. Añadir aquí la IP LAN REAL del servidor.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,100.90.206.74

# Vacío para acceso directo HTTP, incluso por Tailscale.
# Para un origen adicional concreto: https://produccion.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=

# Catálogo central. Mantener la clave fuera del repositorio.
UR_BASE_URL=https://universo.mesaramos.com
UR_API_KEY=
# Compatibilidad con APIs antiguas que no incluyen la unidad por pieza.
# La API nueva entrega weight_unit por pieza; la unidad central siempre prevalece.
UR_WEIGHT_UNIT=
UR_REQUEST_TIMEOUT_SECONDS=25
